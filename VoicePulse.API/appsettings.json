{
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=VoicePulse;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "ApplicationName": "VoicePulse"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Key": "",
    "Issuer": "VoicePulseApp",
    "Audience": "VoicePulseApp Users",
    "ExpiryMinutes": 30
  }
}
